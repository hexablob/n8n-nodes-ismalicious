{
  "name": "n8n-nodes-ismalicious",
  "version": "0.1.1",
  "description": "n8n node to look up IPs, domains, and URLs on isMalicious",
  "license": "MIT",
  "homepage": "https://ismalicious.com/integrations/n8n",
  "author": {
    "name": "isMalicious",
    "email": "contact@ismalicious.com",
    "url": "https://ismalicious.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexablob/n8n-nodes-ismalicious.git"
  },
  "bugs": {
    "url": "https://github.com/hexablob/n8n-nodes-ismalicious/issues"
  },
  "main": "dist/nodes/IsMalicious/IsMalicious.node.js",
  "keywords": [
    "n8n-community-node-package",
    "threat-intelligence",
    "ismalicious"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IsMaliciousApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IsMalicious/IsMalicious.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('nodes/IsMalicious/ismalicious.svg','dist/nodes/IsMalicious/ismalicious.svg')\"",
    "lint": "node scripts/scan-package.mjs --source",
    "scan": "npm run build && node scripts/scan-package.mjs",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
