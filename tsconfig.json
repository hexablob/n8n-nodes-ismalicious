{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "credentials/**/*.ts", "nodes/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
